> 
> ## Proposal covariance matrix
> h = c(.1, 1, 10)
> 
> output = list()
> out_rho = list()
> 
> for(k in 1:length(h))
+ {
+ 	prop_cov = h[k]*diag(2) 
+ 	for(i in 1:length(rho))
+ 	{
+ 		tar_cov = matrix(c(1, rho[i], rho[i], 1), nrow = 2)
+ 		for(j in 1:n)
+ 		{
+ 
+ 			A_block[j, i] = alpha_block(w_init, tar_mean, tar_cov, prop_cov)
+ 
+ 			x1 = rnorm(1, rho[i]*w_init[2], sqrt(prop_cov[1, 1]*(1-rho[i]^2)))
+ 			A_star_cmh[j, i] = alpha_cmh(w_init, x1, tar_mean, tar_cov) #mean(A_mh)
+ 
+ 			z = rnorm(2, w_init, sqrt(lambda))
+ 			A_star_proximal[j, i] = alpha_proximal(w_init, z, tar_mean,
+ 			                                tar_cov, prop_cov, lambda)
+ 
+ 		}
+ 
+ 	}
+ 
+ 	output[[k]] = list(A_block, A_star_cmh, A_star_proximal)
+ }
