> x_2 = seq(1, 6, length.out = 200)
> 
> lower_bound = function(x_2){
+ 	out = 1 - exp(-x_2^2 + x_2)
+ 	return(out)
+ }
> 
> pdf("CIMH_lower_bound.pdf", width = 5, height = 5)
